# arXiv MCP server configuration.
#
# Copy this file to `.env` in the project root (next to package.json), or point
# ARXIV_MCP_ENV_FILE at it from your MCP client config. Values set in the MCP
# client's "env" block always take precedence over this file.
# Relative paths are resolved against the directory containing this .env file.

# Where downloaded PDFs and extracted text are stored.
# Default: ~/.arxiv-mcp-server/papers  (STORAGE_DIR is also accepted)
ARXIV_STORAGE_DIR=~/.arxiv-mcp-server/papers

# debug | info | warn | error | silent   (logs go to stderr, never stdout)
LOG_LEVEL=info

# Optional: also append logs to this file.
# LOG_FILE=~/.arxiv-mcp-server/server.log

# Minimum delay between requests to arXiv. arXiv asks for at least 3000 ms.
RATE_LIMIT_DELAY_MS=3000

# Per-request timeout for arXiv API calls.
REQUEST_TIMEOUT_MS=20000

# Refuse to download PDFs larger than this (0 = no limit).
MAX_PDF_SIZE_MB=50

# Refuse downloads once local storage exceeds this size (0 = no limit).
MAX_STORAGE_SIZE_MB=0

# Optional: JSON file with extra/overriding analysis prompt templates
# (same format as prompts/prompts.json).
# PROMPTS_FILE=~/.arxiv-mcp-server/my-prompts.json
