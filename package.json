{
  "name": "arxiv-mcp-server",
  "version": "2.0.1",
  "description": "MCP server for arXiv: search papers, browse the category taxonomy, download PDFs and read their full text",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "arxiv-mcp-server": "build/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "prepare": "npm run build",
    "start": "node build/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arxiv",
    "research",
    "papers",
    "pdf",
    "scientific-papers"
  ],
  "author": "MaksPyn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaksPyn/arxiv-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/MaksPyn/arxiv-mcp-server/issues"
  },
  "homepage": "https://github.com/MaksPyn/arxiv-mcp-server#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "build/",
    "prompts/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
